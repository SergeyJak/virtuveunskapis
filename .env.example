# Generate both values interactively: npm run admin:password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Absolute path on a persistent volume in production (single server instance).
# Local development defaults to .runtime/ if this is empty.
ADMIN_DATA_DIR=
# Set to the exact public origin behind a reverse proxy, without trailing slash.
# SITE_ORIGIN=https://virtuves.heysmart.lv
# Additional trusted HTTPS origins, comma-separated, without trailing slashes.
# ADDITIONAL_SITE_ORIGINS=https://virtuveunskapis-production.up.railway.app
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
# Only enable if your reverse proxy overwrites client IP headers and direct access is blocked.
TRUST_PROXY_HEADERS=false
